{
  "entities": {
    "Student": {
      "title": "Student / Member",
      "description": "Represents a member or student in the application",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string", "maxLength": 30 },
        "alphaCode": { "type": "string", "maxLength": 20 },
        "cpf": { "type": "string", "maxLength": 20 },
        "roles": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" },
        "photoUrl": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Event": {
      "title": "Event",
      "description": "An event to be tracked",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 250 },
        "description": { "type": "string", "maxLength": 5000 },
        "date": { "type": "string" },
        "location": { "type": "string", "maxLength": 500 },
        "status": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      }
    },
    "Attendance": {
      "title": "Attendance Record",
      "description": "A record of attendance or event enrollment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["inscrito", "presente", "apto_para_certificado", "cancelado"] },
        "timestamp": { "type": "string" }
      }
    },
    "Appointment": {
      "title": "Appointment",
      "description": "An appointment booking record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "availabilityId": { "type": "string", "maxLength": 128 },
        "memberId": { "type": "string", "maxLength": 128 },
        "professionalId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "Availability": {
      "title": "Availability",
      "description": "A professional availability time slot",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "professionalId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "status": { "type": "string", "enum": ["LIVRE", "OCUPADO", "CANCELADO"] }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "System notification for users or admins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "read": { "type": "boolean" },
        "type": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "DobloLog": {
      "title": "Doblo Vehicle Log",
      "description": "Log entry for vehicle usage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "driverName": { "type": "string", "maxLength": 150 },
        "destination": { "type": "string", "maxLength": 300 },
        "departureTime": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "MuralPost": {
      "title": "Mural Post",
      "description": "Community wall post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 150 },
        "content": { "type": "string", "maxLength": 2500 },
        "createdAt": { "type": "string" }
      }
    },
    "OnlinePresence": {
      "title": "Online Presence",
      "description": "Ephemeral online user presence tracking",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "lastActive": { "type": "string" },
        "userAgent": { "type": "string" }
      }
    },
    "TelemetryScan": {
      "title": "Telemetry QR Scan",
      "description": "Log of QR code scan events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["badge", "event", "certificate", "visitor"] },
        "codeSummary": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "Certificate": {
      "title": "Certificate Record",
      "description": "Registered certificate for event attendance or organization",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 128 },
        "eventId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "memberRa": { "type": "string", "maxLength": 50 },
        "memberName": { "type": "string", "maxLength": 150 },
        "memberCourse": { "type": "string", "maxLength": 150 },
        "eventTitle": { "type": "string", "maxLength": 250 },
        "hours": { "type": "number" },
        "isOrganizer": { "type": "boolean" },
        "issuedAt": { "type": "string" },
        "releasedAt": { "type": "string" },
        "legacyCode": { "type": "string", "maxLength": 128 }
      }
    },
    "Admin": {
      "title": "Authorized Admin",
      "description": "System administrator record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["email"]
    },
    "CourseOffer": {
      "title": "Course and Offer",
      "description": "Educational courses, hotmart products, diocesan partnerships, and publications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 250 },
        "category": { "type": "string" },
        "description": { "type": "string", "maxLength": 5000 },
        "active": { "type": "boolean" },
        "price": { "type": "string" },
        "workload": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Poll": {
      "title": "Community Poll",
      "description": "Interactive voting poll for community or academic feedback",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 250 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      }
    },
    "PollVote": {
      "title": "Poll Vote",
      "description": "Single vote cast for a poll",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pollId": { "type": "string" },
        "optionId": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "CardUsage": {
      "title": "Card Discount Usage",
      "description": "Log of student discount usages",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "type": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "SystemLiveStatus": {
      "title": "System Live Status",
      "description": "Status of live broadcasts and system streams",
      "type": "object",
      "properties": {
        "isLive": { "type": "boolean" },
        "channel": { "type": "string" },
        "checkedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/artifacts/{appId}/public/data/students": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Stores students and members directory records"
    },
    "/artifacts/{appId}/public/data/events": {
      "schema": { "$ref": "#/entities/Event" },
      "description": "Stores academic and diocesan events"
    },
    "/artifacts/{appId}/public/data/attendances": {
      "schema": { "$ref": "#/entities/Attendance" },
      "description": "Stores event attendance and enrollment records"
    },
    "/artifacts/{appId}/public/data/certificates": {
      "schema": { "$ref": "#/entities/Certificate" },
      "description": "Stores issued certificates and validation records"
    },
    "/artifacts/{appId}/public/data/appointments": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Stores appointments"
    },
    "/artifacts/{appId}/public/data/availabilities": {
      "schema": { "$ref": "#/entities/Availability" },
      "description": "Stores appointment availability slots"
    },
    "/artifacts/{appId}/public/data/notifications": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Stores user and admin alerts"
    },
    "/artifacts/{appId}/public/data/doblo_logs": {
      "schema": { "$ref": "#/entities/DobloLog" },
      "description": "Stores vehicle logs"
    },
    "/artifacts/{appId}/public/data/mural_posts": {
      "schema": { "$ref": "#/entities/MuralPost" },
      "description": "Stores community board announcements and posts"
    },
    "/artifacts/{appId}/public/data/online_presence": {
      "schema": { "$ref": "#/entities/OnlinePresence" },
      "description": "Realtime online active sessions"
    },
    "/artifacts/{appId}/public/data/telemetry_scans": {
      "schema": { "$ref": "#/entities/TelemetryScan" },
      "description": "Recent QR code scan telemetry logs"
    },
    "/artifacts/{appId}/public/data/card_usages": {
      "schema": { "$ref": "#/entities/CardUsage" },
      "description": "Stores student ID discount telemetry logs"
    },
    "/artifacts/{appId}/public/data/system_live_status": {
      "schema": { "$ref": "#/entities/SystemLiveStatus" },
      "description": "Stores realtime live streaming status"
    },
    "/artifacts/{appId}/public/data/admins": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Stores authorized administrator accounts and permissions"
    },
    "/artifacts/{appId}/public/data/courses_offers": {
      "schema": { "$ref": "#/entities/CourseOffer" },
      "description": "Stores course offerings, extension programs, and partner courses"
    },
    "/artifacts/{appId}/public/data/polls": {
      "schema": { "$ref": "#/entities/Poll" },
      "description": "Stores polls and surveys"
    },
    "/artifacts/{appId}/public/data/poll_votes": {
      "schema": { "$ref": "#/entities/PollVote" },
      "description": "Stores votes cast on polls"
    }
  }
}
