rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Community mural attachments (images)
    match /mural/{imageId=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 15 * 1024 * 1024;
    }

    // Profile photos & general uploads
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 20 * 1024 * 1024;
    }
  }
}

