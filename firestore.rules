rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regras completas para o aplicativo DAVVERO: acesso irrestrito para leitura e escrita
    // em todas as coleções do app, evitando erros de permissão em produção e preview.
    match /artifacts/{appId} {
      allow read, write: if true;
    }

    match /artifacts/{appId}/{document=**} {
      allow read, write: if true;
    }

    // Coleções na raiz
    match /push_subscriptions/{document=**} {
      allow read, write: if true;
    }

    match /fcm_tokens/{document=**} {
      allow read, write: if true;
    }

    match /mail/{document=**} {
      allow read, write: if true;
    }

    match /courses_offers/{document=**} {
      allow read, write: if true;
    }

    match /polls/{document=**} {
      allow read, write: if true;
    }

    match /poll_votes/{document=**} {
      allow read, write: if true;
    }

    // Regra global de leitura e escrita
    match /{document=**} {
      allow read, write: if true;
    }
  }
}


