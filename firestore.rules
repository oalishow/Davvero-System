rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isAdmin() {
      return isSignedIn() && (
        // Administradores fixos autorizados
        request.auth.token.email in [
          'admblackjamf@gmail.com',
          'comunicacao@fajopa.edu.br',
          'danilo@fajopa.edu.br',
          'suporte@fajopa.edu.br',
          'secretaria@fajopa.edu.br'
        ] ||
        // Domínio oficial FAJOPA
        (request.auth.token.email != null && request.auth.token.email.matches('.*@fajopa[.]edu[.]br$')) ||
        // Custom claims do Firebase Auth (atribuídas via servidor)
        request.auth.token.admin == true
      );
    }

    // Connection test document
    match /artifacts/{appId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Trigger Email extension collection
    match /mail/{document=**} {
      allow read, write: if isAdmin();
    }

    // WebPush Subscriptions & Tokens
    match /push_subscriptions/{subId} {
      allow read, write: if isSignedIn();
    }
    match /fcm_tokens/{tokenId} {
      allow read, write: if isSignedIn();
    }

    // DAVVERO public data collection
    match /artifacts/{appId}/public/data {

      // Students & Members, Settings, and Assets
      match /students/{studentId} {
        allow read: if true;
        // Documentos do sistema e configurações (_settings_global, _asset_*) só podem ser alterados por administradores
        allow write: if studentId.matches('^_.*') && isAdmin();
        // Cadastros normais de membros/alunos (não iniciados por _)
        allow create, update: if !studentId.matches('^_.*') && isSignedIn();
        allow delete: if isAdmin();
      }

      // Events
      match /events/{eventId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Attendances
      match /attendances/{attendanceId} {
        allow read: if true;
        allow create, update: if isSignedIn();
        allow delete: if isAdmin();
      }

      // Certificates
      match /certificates/{certificateId} {
        allow read: if true;
        allow create, update: if isSignedIn();
        allow delete: if isAdmin();
      }

      // Appointments
      match /appointments/{appointmentId} {
        allow read: if true;
        allow create, update: if isSignedIn();
        allow delete: if isAdmin();
      }

      // Availabilities
      match /availabilities/{availabilityId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Notifications
      match /notifications/{notificationId} {
        allow read: if true;
        allow create, update: if isSignedIn();
        allow delete: if isAdmin();
      }

      // Doblo logs
      match /doblo_logs/{logId} {
        allow read: if true;
        allow create, update: if isSignedIn();
        allow delete: if isAdmin();
      }

      // Community Board (Mural)
      match /mural_posts/{postId} {
        allow read: if true;
        allow create, update: if isSignedIn();
        allow delete: if isAdmin();

        match /comments/{commentId} {
          allow read: if true;
          allow create, update: if isSignedIn();
          allow delete: if isAdmin();
        }
      }

      // Authorized Administrators
      match /admins/{adminId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Admin invites
      match /admin_invites/{email} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Telemetry & Realtime Online Presence
      match /online_presence/{sessionId} {
        allow read, write: if true;
      }

      match /telemetry_stats/{docId} {
        allow read, write: if true;
      }

      match /telemetry_daily/{dateKey} {
        allow read, write: if true;
      }

      match /telemetry_scans/{scanId} {
        allow read, write: if true;
      }

      // Catch-all inside app data namespace
      match /{document=**} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

